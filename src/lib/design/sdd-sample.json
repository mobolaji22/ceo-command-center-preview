 "territories": [
  {
   "id": "territory.conservative",
   "concept": "Roastery Notice",
   "thesis": "A clear subscription page with the week's roast date as its first fact",
   "posture": "CONSERVATIVE",
   "meaningInterpretation": "Freshness is the promise, and the roast date is its proof; the page must show the date before it asks for a subscription.",
   "audienceExperience": "A home brewer who buys in shops sees the roast date first and feels they are buying from the roaster, not a reseller.",
   "composition": "A single column from the roast date to the subscription and its terms.",
   "typography": "A sturdy grotesque for headings, tabular figures for dates and prices.",
   "artDirection": "Beans and bags photographed in the roastery, with the date stamp in frame.",
   "colourAndMaterial": null,
   "interactionAndMotion": null,
   "signature": {
    "noneBecause": "The roast date carries the page; a further device would compete with it"
   },
   "addressesBrief": "Puts the roast date and the pause or cancel terms where the trust requirements ask for them.",
   "deliberatelyNot": "Does not lead with discounts, origin romance or a product grid.",
   "strengths": [
    "The proof is visible in the first screen"
   ],
   "weaknesses": [
    "Relies on the roastery having a weekly date to show"
   ],
   "risks": [
    "Reads as a shop page if the date is small"
   ],
   "tradeoffs": [
    "Proof over atmosphere"
   ],
   "implementationImplications": [
    "The roast date is data the site must read each week"
   ],
   "referenceLinks": [],
   "technique": "conventional",
   "techniqueMapping": "Deliberately familiar: subscription-site conventions keep ordering obvious, and the roast date is the one thing raised above them.",
   "tokens": {
    "colour": {
     "surface.base": "unbleached kraft"
    },
    "type": {
     "date": "tabular figures, large"
    },
    "space": {
     "section": "generous"
    }
   },
   "keyFrameIds": [
    "territory.conservative.desktop",
    "territory.conservative.phone"
   ],
   "studyFrameIds": [],
   "rendered": false,
   "previewRefs": [],
   "status": "PROPOSED"
  },
  {
   "id": "territory.distinctive",
   "concept": "Batch Ticket",
   "thesis": "Every page is a batch ticket: date, origin and roast written as the roaster writes them",
   "posture": "DISTINCTIVE",
   "meaningInterpretation": "Freshness is the promise, and the roast date is its proof; the page must show the date before it asks for a subscription.",
   "audienceExperience": "A home brewer who buys in shops sees the roast date first and feels they are buying from the roaster, not a reseller.",
   "composition": "A ticket-shaped panel anchors the first screen, with the subscription as its last line.",
   "typography": "A sturdy grotesque for headings, tabular figures for dates and prices.",
   "artDirection": "Beans and bags photographed in the roastery, with the date stamp in frame.",
   "colourAndMaterial": null,
   "interactionAndMotion": null,
   "signature": {
