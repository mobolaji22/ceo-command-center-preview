# How the Command Center gets its data.
#   fixtures = in-memory demo data, no backend needed (default for local development)
#   api      = the dev-playbook-v4 API, through this app's own server
NEXT_PUBLIC_DATA_SOURCE=fixtures

# Server only. Where this app's server finds the v4 API (never exposed to the browser).
V4_API_URL=http://localhost:4000

# The public origin of this app. State-changing requests must come from it (cross-site request protection).
# Defaults to the request's own origin; set it when running behind a proxy.
APP_ORIGIN=http://localhost:3000

# Demo deployments only: allow fixtures in a production build.
# NEXT_PUBLIC_ALLOW_FIXTURES=true
